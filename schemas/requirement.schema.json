{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pryv/compliance-matrix/schemas/requirement.schema.json",
  "title": "Requirement",
  "description": "A single mapped requirement inside a scope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref", "title", "coverage"],
  "properties": {
    "ref": {
      "type": "string",
      "description": "Official identifier within the scope (e.g., 'Art.5', '164.312(a)(1)', 'A.8.24').",
      "pattern": "^[A-Za-z0-9._()\\-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "description": "Paraphrased requirement text. Do NOT redistribute copyrighted standards verbatim."
    },
    "text_url": {
      "type": "string",
      "format": "uri",
      "description": "Direct link to the canonical text of this requirement."
    },
    "coverage": {
      "enum": ["implemented", "configurable", "facilitated", "documented", "out-of-scope"]
    },
    "notes": {
      "type": "string",
      "description": "Freeform nuance — gotchas, multi-aspect breakdowns, exceptions."
    },
    "draft": {
      "type": "boolean",
      "default": true,
      "description": "True when authored but not yet user-reviewed."
    },
    "reviewed_by": {
      "type": ["string", "null"]
    },
    "reviewed_at": {
      "type": ["string", "null"],
      "format": "date"
    },
    "functional_specs": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Dotted ID from dev-site/src/_functional-specifications/requirements.yml (e.g., 'EVENT.BASE')."
      },
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Test code as used in open-pryv.io test descriptions (e.g., 'EVTC').",
        "pattern": "^[A-Z][A-Z0-9]+$"
      },
      "uniqueItems": true
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Relative path into dev-site/src/ or compliance-matrix/docs/ (may include #anchor)."
      },
      "uniqueItems": true
    },
    "qms_docs": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Relative path into compliance-matrix/qms/."
      },
      "uniqueItems": true
    },
    "config_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Dotted config key in open-pryv.io (e.g., 'storages.engines.postgresql.database')."
      },
      "uniqueItems": true
    },
    "planned": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tracking_url": {
          "type": "string",
          "format": "uri",
          "description": "GitHub issue, project board item, or backlog plan URL."
        },
        "eta_release": {
          "type": "string",
          "description": "Target open-pryv.io release (e.g., '2.1.0')."
        }
      }
    },
    "applies_to_versions": {
      "type": "string",
      "description": "semver-range constraint of open-pryv.io versions this row describes (e.g., '>=2.0.0').",
      "default": "*"
    },
    "derives_from": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Cross-scope reference (e.g., 'gdpr.Art.5') indicating this requirement inherits evidence from another scope's row."
      },
      "uniqueItems": true
    }
  }
}
